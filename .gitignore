# TeamFlow 运行日志（插件自有产物，非交付物；host 提交时另有 pathspec 强制排除）
logs/teamflow/

# 公网部署运行时产物：日志、CD 状态/锁、手工冻结开关、一次性运维脚本。
# 这些只存在于服务器 ~/skillcoach/，绝不能进版本库（含库名、行数、口令路径线索）。
/logs/*.log
/logs/deploy-state
/logs/deploy.lock.fd
/logs/demo-account.txt
/deploy.freeze
/verify_public.py
/harden-perms.sh
/restore-drill.sh
/rotate-pg-password.sh
/bootstrap.sh

# 服务器 ~/skillcoach/ 的整个运行时目录与一次性上传包：整目录忽略，
# 既消掉 git status 噪音，也避免误用 git clean 删掉备份日志 / 演示账号凭据。
/logs/
/*.tgz

# 前端：依赖、构建产物、缓存
# .pnpm-store/ 必须忽略：其 v11/projects/*/node_modules 与项目目录存在链接关系，
# 曾被 rm -rf 遍历导致 frontend/ 源码被误删（2026-10-31 事故）
.pnpm-store/
node_modules/
# 本机沙箱禁止 symlink，pnpm 的 isolated 布局退化成残缺副本（删不掉时改名以 node_modules 开头）
node_modules-*/
dist/
frontend/.vite/
frontend/.npm-cache/
*.tsbuildinfo
coverage/

# 后端：虚拟环境、缓存、本地库
__pycache__/
*.py[cod]
backend/.venv/
venv/
.venv/
# 通用缓存目录（无 backend/ 前缀）：pytest/ruff 在 backend/ 下运行时产物落在
# backend/.pytest_cache，但从仓库根调用或编辑器插件也可能落在根目录，统一覆盖
.pytest_cache/
.ruff_cache/
backend/pytest-cache-files-*/
backend/.test-scaffold.db
*.db
*.sqlite3
# SQLite 旁路文件：`*.db` 匹配不到 `app.db-wal` / `app.db-shm`（WAL 模式或崩溃残留会留在库里）
*.db-wal
*.db-shm
*.db-journal
*.sqlite3-wal
# 数据库手工快照（`app.db.bak-<时间戳>`，排查/重建前留的副本）：与 *.db 同理，绝不入库
*.db.bak-*
*.sqlite3-shm
# 后端 pytest 临时目录（backend/tests/conftest.py 的 SCRATCH_DIR，运行后自建）
backend/tests/.tmp/
# pytest 在仓库根的临时目录（tmp_path 工厂，形如 pytest-of-user/）
pytest-of-*/
# 在 backend/ 下跑 pip-audit / pip install 时，pip 会在 cwd 建 `tmpXXXXXXXX/`
# 隔离环境（里面是整份 site-packages，23MB 级）；这类目录绝不能进仓库。
backend/tmp[a-z0-9]*/

# 密钥（示例文件保留）
.env
.env.*
!.env.example
# r97：公网部署的后端配置模板要进仓库，真实 backend/.env 仍然忽略
!.env.production.example

# 公网 Basic Auth 密码文件（内网穿透暴露端口后的唯一鉴权闸门）：绝不入库，
# 本地用 scripts/gen-htpasswd.sh 生成；compose 运行时挂载进 nginx 容器
frontend/.htpasswd

# 编辑器与系统
.vscode/
.idea/
.trae/
# vite build 的 TEMP/TMP 兜底目录（本机沙箱清理钩子会拦住 esbuild 的临时文件，
# 把 TEMP 指到项目内才构建得过去；纯缓存，不入库）
.tmpbuild/
# IDE 预览分享包（HTML 导出 zip，非交付物）
.trae-html-share-packages/
*.log
.DS_Store

# 本地工作台数据与备份包（不入库）
.workbuddy/
code_learning-src-*.zip

# 本地测试报告（junitxml 输出，不入库）
backend/*.xml

# ---- 公网部署产物（r97）：证书、ACME 验证目录、数据库备份、compose 生产变量 ----
# 证书里有私钥，webroot 是续期临时文件，备份是整库副本：三者都绝不入库。
certs/
certbot/
backups/
deploy.env
