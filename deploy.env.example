# =============================================================================
# 公网部署的 compose 层配置（deploy.env） · 只放「编排需要插值」的变量
# -----------------------------------------------------------------------------
#   cp deploy.env.example deploy.env
#   docker compose -f docker-compose.yml -f docker-compose.prod.yml \
#     --env-file deploy.env up -d --build
#
# 与 backend/.env 的分工（不要混）：
#   deploy.env   → compose 插值：宿主端口、域名（给脚本用），**不含任何 Key**；
#   backend/.env → 应用配置：CORS/COOKIE/AI Key/限流阈值（模板见 backend/.env.production.example）。
# =============================================================================

# 宿主调试口：公网只走 80/443，8080 绑回环仅供本机排障（curl 127.0.0.1:8080/health）。
# 本行已经是「只绑回环」；要彻底关掉这个口，用 iptables/安全组再兜一层。
# 不要写成 `0.0.0.0:8080` —— 那等于把未加密入口重新暴露到公网。
# 另注意：起栈必须带 `--env-file deploy.env`。基础 compose 的默认值现已收紧为
# `${WEB_PORT:-127.0.0.1:8080}`，但若根 .env / 宿主 shell 里残留旧格式的
# `WEB_PORT=8080`（纯端口 = 0.0.0.0），仍会把明文入口暴露出去。
WEB_PORT=127.0.0.1:8080

# 证书与跳转用的正式域名（被 scripts/cert.sh / 文档引用；compose 本身不读它）。
PUBLIC_DOMAIN=your-domain.example

# ACME 联系邮箱（证书到期提醒；Let's Encrypt 要求可联系）。
ACME_EMAIL=you@example.com

# ---- 纯 IP 部署（无域名）用：scripts/cert-ip.sh 读取，域名档不用管这两行 ----
# Let's Encrypt 自 2026-01-15 起正式签发 IP 地址证书，SAN 里直接写 IPv4/IPv6，
# 浏览器访问 https://<IP> 即为绿锁，可以保留完整的 APP_ENV=production 安全档。
# 约束：强制 shortlived profile、有效期 160 小时（约 6.7 天）、只支持 http-01 / tls-alpn-01、
#       Certbot 需 >= 5.4；所以续期必须全自动，且轻量控制台要放行公网 80。
# 用 cert-ip.sh 时把 PUBLIC_IP 改成真实公网 IP，并保持 CORS_ORIGINS=https://<同一个 IP>。
PUBLIC_IP=203.0.113.10
CERTBOT_IMAGE=certbot/certbot:latest

# ---- r98 数据层：compose 插值用 ----
# 数据库口令：**必须改**，且要与 backend/.env 里 DATABASE_URL 的口令逐字一致
# （compose 用这个变量同时拼 postgres 服务的 POSTGRES_PASSWORD 和后端的连接串）。
# 生成：openssl rand -base64 24 | tr -d '/+=' | head -c 32
POSTGRES_PASSWORD=CHANGE_ME_strong_password
POSTGRES_USER=postgres
POSTGRES_DB=sc_app

# Redis 内存上限：不设的话 allkeys-lru 永远不触发。2C4G 单机取 128mb，按机器内存调。
REDIS_MAXMEMORY=128mb
