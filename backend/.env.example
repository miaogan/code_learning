# 后端配置示例：复制为 .env 后填写。.env 已被 gitignore，绝不提交真实密钥。
# 模型调用只在此处出现密钥（AC-8：前端源码与构建产物中不得出现任何 Key）。
#
# ===== AI 供应商（r9 起可切换，r6/r8 既有语义零变化）=====
# AI_PROVIDER 留空 = legacy：逐字沿用下面「全局 AI」区的 AI_BASE_URL / AI_MODEL / AI_API_KEY / AI_TIMEOUT_S。
# AI_PROVIDER=deepseek 或 lmstudio 时只读该档的 5 项 AI_<档名>_*：
#   base_url / model / api_key 一律【不回落全局】（安全边界：切到本地端点时绝不把云端 Key 发过去）；
#   只有 JSON_MODE（留空 = 继承全局 AI_JSON_MODE）与 TIMEOUT_S（写 0 = 继承全局 AI_TIMEOUT_S）会回落。
# 这里填错不会让服务起不来：未知 provider / 缺 base_url·model / 闭集外的 JSON_MODE 只让 /health 报
# ai_configured=false + 中文说明，请求侧走既有 AI_UNAVAILABLE 503 降级（错误码闭集零新增）。
# provider 取值必须【小写】且逐字：deepseek / lmstudio（写 LMStudio 会被判「未识别」，请求侧 503）。
AI_PROVIDER=
# 全局 JSON 模式，闭集二选一：
#   json_object（默认，请求体带 response_format={"type":"json_object"}，适配 DeepSeek / OpenAI）
#   none（整个 response_format 键不发，适配只接受 text / json_schema 的端点，如 LM Studio）
AI_JSON_MODE=json_object

# --- 档位 1：deepseek（云端，公开端点 + 官方模型名；档内 JSON_MODE 留空 = 继承全局，TIMEOUT_S 0 = 继承全局）---
AI_DEEPSEEK_BASE_URL=https://api.deepseek.com/v1
AI_DEEPSEEK_MODEL=deepseek-chat
# 云端 Key 只填在 backend/.env（示例里永远留空）：留空 = 该档未就绪，不会把请求发出去。
AI_DEEPSEEK_API_KEY=
AI_DEEPSEEK_JSON_MODE=
AI_DEEPSEEK_TIMEOUT_S=0

# --- 档位 2：lmstudio（本机 LM Studio Server，OpenAI 兼容端点）---
AI_LMSTUDIO_BASE_URL=http://localhost:1234/v1
# 必填：本地模型 id 因机器而异，服务端不联网探测 /v1/models，留空 = 该档未就绪。
# 请从 LM Studio 界面复制你已加载的模型 id 填在这里（例如 qwen3.5-9b，具体以你的机器为准）。
AI_LMSTUDIO_MODEL=
# 本地端点默认无鉴权：留空即【不发送】Authorization 头（空 Bearer 会被部分实现判 401）。
AI_LMSTUDIO_API_KEY=
# 本地端点实测：带 response_format={"type":"json_object"} 直接 400，故固定 none（整键不发）。
AI_LMSTUDIO_JSON_MODE=none
# 本地小模型出题 / 画像明显慢于云端：本机 qwen3.5-9b（reasoning 类）单次画像实测 201s，
# 故档内默认给 600s（≈实测 ×3，慢一档的机器也够）；写 0 = 继承全局 AI_TIMEOUT_S。
AI_LMSTUDIO_TIMEOUT_S=600

# ===== 全局 AI（AI_PROVIDER 留空时生效，即 legacy 口径）=====
AI_BASE_URL=https://api.openai.com/v1
AI_API_KEY=
AI_MODEL=gpt-4o-mini
# 统一超时：所有 AI 调用（画像 / 润色 / 面试评分 / 报告文案）共用这一档，不再按功能各自设值。
AI_TIMEOUT_S=600
AI_MAX_RETRIES=1

# ===== r41 图片简历识别（视觉档）=====
# 复用现有 DeepSeek 账号的视觉能力，不引入第三方视觉供应商 / 云 OCR：
#   AI_VISION_BASE_URL / AI_VISION_API_KEY 留空 = 继承上面解析出的主档（同一账号，只换模型名）。
# 模型名：deepseek-flash 支持图像理解；deepseek-v4-pro 不支持，别填错。
# AI_VISION_MODEL 留空 = 图片上传入口未开通：接口明确返回「图片识别未开通，请改用 PDF 上传」，
# 不静默降级、不返回含糊错误。
AI_VISION_MODEL=deepseek-flash
AI_VISION_BASE_URL=
AI_VISION_API_KEY=
# 图片识别超时（秒）；0 = 继承主档（AI_TIMEOUT_S / 具名档 AI_<档>_TIMEOUT_S）。
AI_VISION_TIMEOUT_S=0

# r98 数据层：PostgreSQL 唯一数据源（SQLite 已下线）。
# 端口 5433 是 compose 里 postgres 服务的宿主映射（避开本机已有的 5432）。
DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:5433/sc_app
DB_POOL_MIN_SIZE=1
DB_POOL_MAX_SIZE=10
DB_POOL_TIMEOUT_S=10
# Redis：留空 / memory:// = 进程内兜底（单副本可用，多副本限流失真）。
REDIS_URL=redis://127.0.0.1:6380/0
REDIS_PREFIX=sc
SESSION_CACHE_TTL_S=60
READ_CACHE_TTL_S=30
LOCK_TTL_S=900
MAX_UPLOAD_MB=10
CORS_ORIGINS=http://127.0.0.1:5173,http://localhost:5173
# 日志级别：DEBUG / INFO / WARNING / ERROR（非法值按 INFO，不会因为写错起不来）。
# 每行日志都带 request_id，响应头 X-Request-Id 与之一致；排查时按该 id 过滤即可拿到整条链路。
LOG_LEVEL=INFO

# ===== r23 登录 / 多用户 / 用户自带 Key =====
# 加密用户 API Key 的主密钥：openssl rand -hex 32；为空时禁止保存用户 Key（返回 503）。
SECRET_KEY=
# 会话 Cookie 有效期（天）。
SESSION_DAYS=30
# 生产 https 环境置 true；本机 http 开发保持 false，否则浏览器不会保存 Cookie。
COOKIE_SECURE=false
# 内置（shared）Key 每用户每日 AI 调用上限；0 = 不限制。
SHARED_AI_DAILY_LIMIT=20
# 登录限流（防口令爆破）：同一邮箱窗口期内失败次数上限 / 锁定时长（分钟）；0 = 关闭限流。
LOGIN_MAX_FAILURES=5
LOGIN_LOCKOUT_MINUTES=15


# --- r67 技术雷达（先锋 / 国子监） -----------------------------------------
# 离线模式：true = 完全不访问上游，只读 seed/radar_samples.json（无网 / 无 Key 可端到端演示）。
RADAR_OFFLINE=false
# 应用内定时采集（inapp = 随服务启动的 asyncio 循环；off = 只允许「立即采集」手动触发）。
RADAR_SCHEDULE=inapp
# 采集时刻（逗号分隔 HH:MM，北京时间）。18:00 的下一次是次日 08:00，跨日空窗用手动采集弥补。
RADAR_SLOTS=08:00,12:00,18:00
# 单源超时（秒）与单源读字节上限（超限截断）。
RADAR_FETCH_TIMEOUT_S=8
RADAR_FETCH_MAX_BYTES=2000000
# 采集跳过 TLS 证书校验（默认 false）。只在企业代理 / 自签证书的内网环境**临时**打开：
# 打开后上游内容可被中间人篡改（会进题库与国子监生成），处理完请立刻关回。
# 更稳的做法是把企业 CA 挂进容器并指向 SSL_CERT_FILE，而不是关校验。
RADAR_INSECURE_TLS=false
# 一轮最多评估多少条技术 / GitHub 检索的最低 star 门槛。
RADAR_RUN_MAX_TECHS=40
RADAR_MIN_STARS=100
# 每轮最多几条走模型评估（其余走规则评估，控制成本）。
RADAR_MAX_ASSESS_PER_ROUND=3
# 评估专用超时（秒）；生成任务级硬上限（秒）；单次生成最多保留几道样例题。
RADAR_ASSESS_TIMEOUT_S=60
RADAR_GEN_TIMEOUT_S=300
RADAR_GEN_MAX_QUESTIONS=5
# 读路径惰性清扫阈值（分钟）：running 超时的任务按 failed 落库。
RADAR_JOB_STALE_MINUTES=15
# GitHub Search API token：未认证配额低且易 403，可选。
GITHUB_TOKEN=
# 采集后是否自动为「必学」项生成样例（默认关：每条都要烧模型配额）。
RADAR_AUTO_GENERATE=false
