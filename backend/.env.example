# 后端配置示例：复制为 .env 后填写。.env 已被 gitignore，绝不提交真实密钥。
# 模型调用只在此处出现密钥（AC-8：前端源码与构建产物中不得出现任何 Key）。
#
# ===== AI 供应商（r9 起可切换，r6/r8 既有语义零变化）=====
# AI_PROVIDER 留空 = legacy：逐字沿用下面「全局 AI」区的 AI_BASE_URL / AI_MODEL / AI_API_KEY / AI_TIMEOUT_S。
# AI_PROVIDER=deepseek 或 lmstudio 时只读该档的 5 项 AI_<档名>_*：
#   base_url / model / api_key 一律【不回落全局】（安全边界：切到本地端点时绝不把云端 Key 发过去）；
#   只有 JSON_MODE（留空 = 继承全局 AI_JSON_MODE）与 TIMEOUT_S（写 0 = 继承全局 AI_TIMEOUT_S）会回落。
# 这里填错不会让服务起不来：未知 provider / 缺 base_url·model / 闭集外的 JSON_MODE 只让 /health 报
# ai_configured=false + 中文说明，请求侧走既有 AI_UNAVAILABLE 503 降级（错误码闭集零新增）。
# provider 取值必须【小写】且逐字：deepseek / lmstudio（写 LMStudio 会被判「未识别」，请求侧 503）。
AI_PROVIDER=
# 全局 JSON 模式，闭集二选一：
#   json_object（默认，请求体带 response_format={"type":"json_object"}，适配 DeepSeek / OpenAI）
#   none（整个 response_format 键不发，适配只接受 text / json_schema 的端点，如 LM Studio）
AI_JSON_MODE=json_object

# --- 档位 1：deepseek（云端，公开端点 + 官方模型名；档内 JSON_MODE 留空 = 继承全局，TIMEOUT_S 0 = 继承全局）---
AI_DEEPSEEK_BASE_URL=https://api.deepseek.com/v1
AI_DEEPSEEK_MODEL=deepseek-chat
# 云端 Key 只填在 backend/.env（示例里永远留空）：留空 = 该档未就绪，不会把请求发出去。
AI_DEEPSEEK_API_KEY=
AI_DEEPSEEK_JSON_MODE=
AI_DEEPSEEK_TIMEOUT_S=0

# --- 档位 2：lmstudio（本机 LM Studio Server，OpenAI 兼容端点）---
AI_LMSTUDIO_BASE_URL=http://localhost:1234/v1
# 必填：本地模型 id 因机器而异，服务端不联网探测 /v1/models，留空 = 该档未就绪。
# 请从 LM Studio 界面复制你已加载的模型 id 填在这里（例如 qwen3.5-9b，具体以你的机器为准）。
AI_LMSTUDIO_MODEL=
# 本地端点默认无鉴权：留空即【不发送】Authorization 头（空 Bearer 会被部分实现判 401）。
AI_LMSTUDIO_API_KEY=
# 本地端点实测：带 response_format={"type":"json_object"} 直接 400，故固定 none（整键不发）。
AI_LMSTUDIO_JSON_MODE=none
# 本地小模型出题 / 画像明显慢于云端：本机 qwen3.5-9b（reasoning 类）单次画像实测 201s，
# 故档内默认给 600s（≈实测 ×3，慢一档的机器也够）；写 0 = 继承全局 AI_TIMEOUT_S。
AI_LMSTUDIO_TIMEOUT_S=600

# ===== 全局 AI（AI_PROVIDER 留空时生效，即 legacy 口径）=====
AI_BASE_URL=https://api.openai.com/v1
AI_API_KEY=
AI_MODEL=gpt-4o-mini
# 统一超时：所有 AI 调用（画像 / 润色 / 面试评分 / 报告文案）共用这一档，不再按功能各自设值。
AI_TIMEOUT_S=600
AI_MAX_RETRIES=1
# 用户自带 AI「测试连接」的独立超时（秒）。默认 8；长任务仍用上面的 AI_TIMEOUT_S。
# 这个值同时是 SSRF 探测的时间上限：公网部署不要调大，更不要写成 0 继承 600s。
AI_TEST_TIMEOUT_S=8
# 内网部署开关：允许**用户自带** AI 端点指向私网 / 环回（如 http://10.0.0.5:8000/v1、
# http://localhost:11434/v1）。默认 false = 保持 r99 的 SSRF 防护（只能指向公网）。
# 打开后仍拒绝云元数据与链路本地地址（内网机器也常是云主机，这条不能丢）。
# 公网部署请保持 false —— 打开等于允许任何登录用户用它探测内网端口。
AI_ALLOW_PRIVATE_ENDPOINTS=false

# ===== r41 图片简历识别（视觉档）=====
# 复用现有 DeepSeek 账号的视觉能力，不引入第三方视觉供应商 / 云 OCR：
#   AI_VISION_BASE_URL / AI_VISION_API_KEY 留空 = 继承上面解析出的主档（同一账号，只换模型名）。
# 模型名：deepseek-flash 支持图像理解；deepseek-v4-pro 不支持，别填错。
# AI_VISION_MODEL 留空 = 图片上传入口未开通：接口明确返回「图片识别未开通，请改用 PDF 上传」，
# 不静默降级、不返回含糊错误。
AI_VISION_MODEL=deepseek-flash
AI_VISION_BASE_URL=
AI_VISION_API_KEY=
# 图片识别超时（秒）；0 = 继承主档（AI_TIMEOUT_S / 具名档 AI_<档>_TIMEOUT_S）。
AI_VISION_TIMEOUT_S=0

# ===== r100 RAG 检索（embedding 档位）=====
# 留空 = 离线确定性 HashingEmbedder（char-bigram 特征哈希，零网络 / 零 Key / CI 可复跑）；
# 它的「语义」是字符重叠度（模糊关键词基座），接真实语义模型只需填下面两项。
# 非 LM Studio 用户：DeepSeek 官方端点不提供 /embeddings，云端请指向支持 embedding 的
# OpenAI 兼容服务，或本地起 LM Studio 加载 embedding 模型（如 bge-m3）。
AI_EMBED_MODEL=
# 留空 = 继承主档端点与 Key（同一账号、只换模型名）；显式填写则只认该档。
AI_EMBED_BASE_URL=
AI_EMBED_API_KEY=
# --- r104 本地 embedding 服务（可选，推荐给「不想依赖外部 API」的部署）---
# 服务器上以独立容器运行（compose 的 embedder 档：1 核 / 1GB 硬限额、不发布宿主端口）：
#   docker compose -f docker-compose.yml -f docker-compose.prod.yml --env-file deploy.env \
#     --profile embed up -d embedder
# 启用后把下面三项指向它（bge-small-zh-v1.5 = 512 维；维度变化时 init_db 会自动清空
# 并重建向量列，status 回到「未构建」，到考工页重建索引即可）：
#   AI_EMBED_MODEL=BAAI/bge-small-zh-v1.5
#   AI_EMBED_BASE_URL=http://embedder:8080/v1
#   AI_EMBED_DIM=512
# 不启用时保持 AI_EMBED_MODEL 为空（离线哈希），功能与评测门禁都不受影响。
#
# 向量维度：**进 DDL**（rag_chunks.embedding 是 vector(dim) 列）。
# 默认 256 = HashingEmbedder 的维度；换远端模型后必须改成该模型的输出维度
# （bge-small-zh-v1.5 = 512，bge-m3 = 1024，text-embedding-3-small = 1536，以其文档为准）。
AI_EMBED_DIM=256
# 远端 embedding 单批请求超时（秒）与单批条数。
AI_EMBED_TIMEOUT_S=60
AI_EMBED_BATCH=32

# ===== r119 rerank 精排（可选，默认关）=====
# 留空 = 不精排，检索行为与 r100 一致；填了才会在 semantic / hybrid 检索的
# 融合池上先过交叉编码器再截回 top_k（响应 reranked 字段如实报告是否生效）。
# 端点是 TEI 形态（r118 的 reranker 容器，compose --profile rerank）：
#   AI_RERANK_BASE_URL=http://reranker:8080
# 失败 fail-open：精排抖了只降级回融合序 + notice，检索永不因此 500。
AI_RERANK_BASE_URL=
# 精排单次请求超时（秒）；候选池上限（≤20，reranker 容器 2g 内存限额的约束）。
AI_RERANK_TIMEOUT_S=8
AI_RERANK_POOL=20

# 分块引擎（r103）：auto = 装了 llama-index 就用它的 SentenceSplitter 切正文 /
# native = 全自研（句子累加） / llama = 强制 llama。代码与表格始终自研（按行、带表头）。
RAG_CHUNKER=auto
# 正文切分的 token 上限与重叠（llama SentenceSplitter 直接生效；native 以字符近似）。
RAG_CHUNK_TOKENS=320
RAG_CHUNK_OVERLAP=48
# 启动时是否用种子（app/seed/tutorials_rag.json）补齐教程索引：
# true = 教程 chunk 为 0 时后台摄取一次；false = 只索引题库（教程走考工页手动推送）。
RAG_SEED_TUTORIALS=true

# ===== r117 向量检索后端（与 DB_MODE 同构）=====
# auto = 有 PostgreSQL 就把向量留在 PG（pgvector 形态或降级 double precision[]）；
#        单机（没有 PG）装了 faiss-cpu 用 faiss，没装回落 sqlite（JSON 向量 + Python 余弦）。
# 显式档位不可用时启动即报错（Literal 校验），不静默换档。
#   VECTOR_MODE=pgvector  向量存 rag_chunks.embedding（现状，r100 行为不变）
#   VECTOR_MODE=sqlite    向量存 rag_chunks.embedding（JSON 文本），零额外依赖
#   VECTOR_MODE=faiss     本地单文件派生索引（pip install faiss-cpu，16.6MB，内网推荐）
#   VECTOR_MODE=milvus    远端 Milvus（pip install pymilvus，需配 VECTOR_MILVUS_URI）
VECTOR_MODE=auto
# faiss 索引目录：每个 kind 一个 <kind>.faiss + <kind>.json（对账文件）。默认与
# sqlite_path 同根，备份业务库时把整个 data/ 目录一起拷走即可。
VECTOR_FAISS_DIR=data/rag-vectors
# Milvus 内网地址（standalone 常见 http://milvus:19530）；留空 = milvus 档未配置。
VECTOR_MILVUS_URI=
# Milvus collection 名（字母开头，仅字母/数字/下划线）；留空用默认 rag_chunks。
VECTOR_MILVUS_COLLECTION=

# 数据层：PostgreSQL 权威主库 + SQLite 持久化完整副本 + Redis / 内存缓存。
# 端口 5433 是 compose 里 postgres 服务的宿主映射（避开本机已有的 5432）。
DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:5433/sc_app
DB_POOL_MIN_SIZE=1
DB_POOL_MAX_SIZE=10
DB_POOL_TIMEOUT_S=10
# PG 暂不可用时 Web 进程仍启动：完整 SQLite 副本接管读写；后台按此间隔重试，
# 恢复后暂停业务事务，重放离线日志、重建副本，再回切 PG。没有完整副本时不伪造空库服务。
DB_RECOVERY_INTERVAL_S=2
# HTTP 请求等连接的短窗口；仅在当前权威库不可用、正在恢复或副本不完整时返回
# 503 DATABASE_UNAVAILABLE。正常 PG 故障由后台协调器切换到已有完整副本。
DB_REQUEST_TIMEOUT_S=0.25
# 持久化完整副本路径（不是临时缓存；须备份并防止磁盘写满）。只允许单进程、单 worker
# 后端读写，禁止多副本共享同一个 SQLite 文件。首次 PG 正常初始化后会自动建立副本。
SQLITE_PATH=data/app-fallback.db
# Redis：留空 / memory:// = 进程内缓存（带 TTL / LRU / 前缀失效）；真实 Redis 正常时
# 同时写内存副本，故障期间继续使用。当前完整降级方案只允许单进程、单 worker 部署。
MEMORY_CACHE_MAX_ENTRIES=2048
REDIS_URL=redis://127.0.0.1:6380/0
REDIS_PREFIX=sc
SESSION_CACHE_TTL_S=60
READ_CACHE_TTL_S=30
LOCK_TTL_S=900
MAX_UPLOAD_MB=10
CORS_ORIGINS=http://127.0.0.1:5173,http://localhost:5173
# 日志级别：DEBUG / INFO / WARNING / ERROR（非法值按 INFO，不会因为写错起不来）。
# 每行日志都带 request_id，响应头 X-Request-Id 与之一致；排查时按该 id 过滤即可拿到整条链路。
LOG_LEVEL=INFO

# ===== r23 登录 / 多用户 / 用户自带 Key =====
# 加密用户 API Key 的主密钥：openssl rand -hex 32；为空时禁止保存用户 Key（返回 503）。
SECRET_KEY=
# 会话 Cookie 有效期（天）。
SESSION_DAYS=30
# 生产 https 环境置 true；本机 http 开发保持 false，否则浏览器不会保存 Cookie。
COOKIE_SECURE=false
# 内置（shared）Key 每用户每日 AI 调用上限；0 = 不限制。
SHARED_AI_DAILY_LIMIT=20
# 登录限流（防口令爆破）：同一邮箱窗口期内失败次数上限 / 锁定时长（分钟）；0 = 关闭限流。
LOGIN_MAX_FAILURES=5
LOGIN_LOCKOUT_MINUTES=15


# --- r67 技术雷达（先锋 / 国子监） -----------------------------------------
# 离线模式：true = 完全不访问上游，只读 seed/radar_samples.json（无网 / 无 Key 可端到端演示）。
RADAR_OFFLINE=false
# 应用内定时采集（inapp = 随服务启动的 asyncio 循环；off = 只允许「立即采集」手动触发）。
RADAR_SCHEDULE=inapp
# 采集时刻（逗号分隔 HH:MM，北京时间）。18:00 的下一次是次日 08:00，跨日空窗用手动采集弥补。
RADAR_SLOTS=08:00,12:00,18:00
# 单源超时（秒）与单源读字节上限（超限截断）。
RADAR_FETCH_TIMEOUT_S=8
RADAR_FETCH_MAX_BYTES=2000000
# 采集跳过 TLS 证书校验（默认 false）。只在企业代理 / 自签证书的内网环境**临时**打开：
# 打开后上游内容可被中间人篡改（会进题库与国子监生成），处理完请立刻关回。
# 更稳的做法是把企业 CA 挂进容器并指向 SSL_CERT_FILE，而不是关校验。
RADAR_INSECURE_TLS=false
# 一轮最多评估多少条技术 / GitHub 检索的最低 star 门槛。
RADAR_RUN_MAX_TECHS=40
RADAR_MIN_STARS=100
# 每轮最多几条走模型评估（其余走规则评估，控制成本）。
RADAR_MAX_ASSESS_PER_ROUND=3
# 评估专用超时（秒）；生成任务级硬上限（秒）；单次生成最多保留几道样例题。
RADAR_ASSESS_TIMEOUT_S=60
RADAR_GEN_TIMEOUT_S=300
RADAR_GEN_MAX_QUESTIONS=5
# 读路径惰性清扫阈值（分钟）：running 超时的任务按 failed 落库。
RADAR_JOB_STALE_MINUTES=15
# GitHub Search API token：未认证配额低且易 403，可选。
GITHUB_TOKEN=
# 采集后是否自动为「必学」项生成样例（默认关：每条都要烧模型配额）。
RADAR_AUTO_GENERATE=false
