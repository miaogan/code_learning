# =============================================================================
# 公网部署的后端配置模板（r97） · 复制成 backend/.env 使用
# -----------------------------------------------------------------------------
#   cp backend/.env.production.example backend/.env && chmod 600 backend/.env
#
# 为什么生产配置仍然只放 backend/.env：compose 用 `env_file: ./backend/.env` 把它注入容器，
# 这是既有唯一来源（docker.env.example 首段已写死这条分工）。`deploy.env` 只负责 compose
# 插值（WEB_PORT），两者不要互相复制。
#
# 铁律：
#   1. APP_ENV=production 时，以下 4 类会让后端**拒绝启动**并打印缺哪项：
#      COOKIE_SECURE=false / CORS_ORIGINS 含 * / CORS_ORIGINS 为空 / REDIS_URL 为空。
#      CORS_ORIGINS 写成 http://localhost 这类本机来源**只告警不拒启**（见
#      tests/test_r97_production_guard.py::test_localhost_origin_only_warns）——
#      公网必须改成 https 正式域名，否则写请求会 403。配置错了要当场暴露，而不是带病上线；
#   2. 真实 Key / SECRET_KEY 只进本文件，权限 600，永不入库（.gitignore 已覆盖）；
#   3. 换域名后要同时改 CORS_ORIGINS 与证书，两处不一致会让所有写请求 403。
# =============================================================================

# ---- 运行环境（生产档启用启动期安全校验）----
APP_ENV=production

# ---- 数据层（r98：PostgreSQL 唯一数据源 + Redis 共享层）----
# 容器内本行会被 compose 的 environment.DATABASE_URL 覆盖：真正生效的口令来自
# deploy.env 的 POSTGRES_PASSWORD（同一个变量同时拼给 postgres 服务与后端连接串）。
# 本行只在宿主机直跑 uvicorn / 迁移脚本时有意义，那时才需要自己与 deploy.env 对齐。
# pool 上限按「单副本 × max_connections」估算：3 副本 × 20 已接近 PG 默认 100 的上限。
DATABASE_URL=postgresql://postgres:CHANGE_ME@postgres:5432/sc_app
DB_POOL_MIN_SIZE=1
DB_POOL_MAX_SIZE=10
DB_POOL_TIMEOUT_S=10
# Redis：生产档留空会**拒绝启动**（多副本各自计数＝限流形同虚设）。
# 确认单副本部署时写 memory:// 显式接受降级。
REDIS_URL=redis://redis:6379/0
REDIS_PREFIX=sc
SESSION_CACHE_TTL_S=60
READ_CACHE_TTL_S=30
LOCK_TTL_S=900

# ---- 对外域名与来源 ----
# 浏览器实际访问的 https 域名。多个来源用英文逗号分隔；不要写 *，不要留本机来源。
CORS_ORIGINS=https://your-domain.example
# 会话 Cookie 必须带 Secure（http 下不会下发，登录会「成功但立刻掉线」）。
COOKIE_SECURE=true
# 会话有效期（天）：公网建议 14–30，越短越安全、越长越少重登。
SESSION_DAYS=30

# ---- 密钥 ----
# 加密「用户自带 AI Key」的主密钥：openssl rand -hex 32
# 留空时该功能对所有人不可用（不影响登录与共享 Key 模式）。
SECRET_KEY=

# ---- 应用层防护（r70）：生产不建议关 ----
RATE_LIMIT_ENABLED=true
RATE_LIMIT_WINDOW_S=60
RATE_LIMIT_AUTH_PER_WINDOW=10
RATE_LIMIT_API_PER_WINDOW=120
BREAKER_ENABLED=true
BREAKER_MAX_INFLIGHT=32
LOGIN_MAX_FAILURES=5
LOGIN_LOCKOUT_MINUTES=15
# 共享 Key 模式下每用户每日 AI 调用上限（防单账号烧额度）。
SHARED_AI_DAILY_LIMIT=20

# ---- 上传与日志 ----
# 应用层上限（MB）；nginx 侧固定 20m，必须严格大于本值。
MAX_UPLOAD_MB=10
LOG_LEVEL=INFO

# ---- AI 供应商（示例为 DeepSeek 直连档）----
AI_PROVIDER=deepseek
AI_DEEPSEEK_BASE_URL=https://api.deepseek.com/v1
AI_DEEPSEEK_MODEL=deepseek-chat
# 真实 Key 填在这里（只在本文件，别写进 compose / deploy.env）
AI_DEEPSEEK_API_KEY=
AI_TIMEOUT_S=600
AI_MAX_RETRIES=1
# 用户自带 AI「测试连接」的独立超时（秒）。默认 8；长任务仍用上面的 600。
# 该值同时是 SSRF 探测的时间上限，公网部署不要调大。
AI_TEST_TIMEOUT_S=8

# ---- 图片简历识别（可选）----
# 留空 = 继承主档端点/Key/超时；填了就按视觉档独立计费口径走。
AI_VISION_MODEL=
AI_VISION_BASE_URL=
AI_VISION_API_KEY=
